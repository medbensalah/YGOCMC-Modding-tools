<UserControl x:Class="YGO_CMC_Modding_tool.Controls.BuffCellControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:YGO_CMC_Modding_tool.Controls"
             xmlns:converters="clr-namespace:YGO_CMC_Modding_tool.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="150">
    <UserControl.Resources>
        <converters:BuffDirectionToImageConverter x:Key="BuffDirectionToImageConverter"/>
        <DataTemplate x:Key="BuffItemTemplate">
            <Image Source="{Binding Converter={StaticResource BuffDirectionToImageConverter}}" Width="28" Height="28" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="ATK:" VerticalAlignment="Center" Margin="2"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="AtkComboBox" Margin="2" 
                  SelectedItem="{Binding Atk, Mode=TwoWay}" 
                  ItemTemplate="{StaticResource BuffItemTemplate}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="DEF:" VerticalAlignment="Center" Margin="2"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DefComboBox" Margin="2" 
                  SelectedItem="{Binding Def, Mode=TwoWay}" 
                  ItemTemplate="{StaticResource BuffItemTemplate}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="PP:" VerticalAlignment="Center" Margin="2"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="PpComboBox" Margin="2" 
                  SelectedItem="{Binding Pp, Mode=TwoWay}" 
                  ItemTemplate="{StaticResource BuffItemTemplate}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="SP.ATK:" VerticalAlignment="Center" Margin="2"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="SpaComboBox" Margin="2" 
                  SelectedItem="{Binding Spa, Mode=TwoWay}" 
                  ItemTemplate="{StaticResource BuffItemTemplate}"/>
    </Grid>
</UserControl>