<Page x:Class="YGO_CMC_Modding_tool.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:YGO_CMC_Modding_tool"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:YGO_CMC_Modding_tool.Pages"
      xmlns:vm="clr-namespace:YGO_CMC_Modding_tool.ViewModels"
      mc:Ignorable="d"
      Foreground="{DynamicResource Theme_TextBrush}">

    <Page.Resources>
        <pages:TypeByteToNameConverter x:Key="TypeNameConverter"/>
        <pages:AttributeByteToNameConverter x:Key="AttributeNameConverter"/>
        <pages:PatternByteToImageConverter x:Key="PatternImageConverter"/>
    </Page.Resources>

    <Grid Background="{DynamicResource Theme_BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ISO Path input -->
        <Grid Grid.Row="0" Margin="12 12 12 0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="Source ISO Path" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="SourceIsoPathTextBox" IsReadOnly="True" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Load" Click="OnLoadIso" Padding="16,6" MinWidth="110" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination ISO Path" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,12,0"/>
            <TextBox x:Name="DestinationIsoPathTextBox" IsReadOnly="True" Grid.Row="1" Grid.Column="1" Margin="0,8,12,0" VerticalAlignment="Center" />
            <Button Grid.Column="2"  Grid.Row="1" Content="Select" Click="OnSelectIso" Padding="16,6" MinWidth="110" VerticalAlignment="Center" Margin="0,8,0,0" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Monsters">
                <Frame>
                    <pages:MonstersPage />
                </Frame>
            </TabItem>
            <TabItem Header="Monsters List">
                <Grid>
                    <DataGrid x:Name="MonstersGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="False"
                              ItemsSource="{x:Static vm:MonstersViewModel.LastLoaded}"
                              CanUserSortColumns="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource TypeNameConverter}}" Width="100" SortMemberPath="Type"/>
                            <DataGridTextColumn Header="Attribute" Binding="{Binding Attribute, Converter={StaticResource AttributeNameConverter}}" Width="120" SortMemberPath="Attribute"/>
                            <DataGridTemplateColumn Header="Movement" Width="140" SortMemberPath="MovementPattern">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Stretch="Uniform" Height="40" Source="{Binding MovementPattern, Converter={StaticResource PatternImageConverter}, ConverterParameter=MV}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Attack" Width="140" SortMemberPath="AttackPattern">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Stretch="Uniform" Height="40" Source="{Binding AttackPattern, Converter={StaticResource PatternImageConverter}, ConverterParameter=ATK}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="PP" Binding="{Binding PP}" Width="80" SortMemberPath="PP"/>
                            <DataGridTextColumn Header="AT" Binding="{Binding AT}" Width="80" SortMemberPath="AT"/>
                            <DataGridTextColumn Header="DF" Binding="{Binding DF}" Width="80" SortMemberPath="DF"/>
                            <DataGridTextColumn Header="AP" Binding="{Binding AP}" Width="80" SortMemberPath="AP"/>
                            <DataGridTextColumn Header="pAP" Binding="{Binding pAP}" Width="80" SortMemberPath="pAP"/>
                            <DataGridTextColumn Header="MP" Binding="{Binding MP}" Width="80" SortMemberPath="MP"/>
                            <DataGridTextColumn Header="AESymbol" Binding="{Binding AESymbol}" Width="100" SortMemberPath="AESymbol"/>
                            <DataGridTextColumn Header="AELand" Binding="{Binding AELand}" Width="100" SortMemberPath="AELand"/>
                            <DataGridTextColumn Header="AEMap" Binding="{Binding AEMap}" Width="100" SortMemberPath="AEMap"/>
                            <DataGridTextColumn Header="EXP" Binding="{Binding _exp}" Width="80" SortMemberPath="_exp"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Other">
                <Grid />
            </TabItem>
        </TabControl>
    </Grid>
</Page>
