<Page x:Class="YGO_CMC_Modding_tool.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:YGO_CMC_Modding_tool"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:pages="clr-namespace:YGO_CMC_Modding_tool.Pages"
      mc:Ignorable="d"
      Foreground="{DynamicResource Theme_TextBrush}">

    <Grid Background="{DynamicResource Theme_BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ISO Path input -->
        <Grid Grid.Row="0" Margin="12 12 12 0" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Text="Source ISO Path" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="SourceIsoPathTextBox" IsReadOnly="True" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Load" Click="OnLoadIso" Padding="16,6" MinWidth="110" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Destination ISO Path" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,8,12,0"/>
            <TextBox x:Name="DestinationIsoPathTextBox" IsReadOnly="True" Grid.Row="1" Grid.Column="1" Margin="0,8,12,0" VerticalAlignment="Center" />
            <Button Grid.Column="2"  Grid.Row="1" Content="Select" Click="OnSelectIso" Padding="16,6" MinWidth="110" VerticalAlignment="Center" Margin="0,8,0,0" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="Monsters">
                <Frame>
                    <pages:MonstersPage Name="MonstersDataPage"/>
                </Frame>
            </TabItem>
            <TabItem Header="Monsters List">
                <Frame>
                    <pages:MonstersListPage Name="MonstersDataGridPage"/>
                </Frame>
            </TabItem>
            <TabItem Header="Opponents">
                <Frame>
					<pages:OpponentsPage  Name="OpponentsDataPage"/>
                </Frame>
            </TabItem>
            <TabItem Header="Starter Kits">
                <Frame>
                    <pages:StarterKitsPage  Name="StarterKitsPage"/>
                </Frame>
            </TabItem>
            <TabItem Header="Shops">
                <Frame>
                    <pages:ShopsPage  Name="ShopsPage"/>
                </Frame>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
