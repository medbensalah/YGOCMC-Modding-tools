<Page
    x:Class="YGO_CMC_Modding_tool.Pages.StarterKitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:YGO_CMC_Modding_tool.Pages"
    xmlns:vm="clr-namespace:YGO_CMC_Modding_tool.ViewModels"
    mc:Ignorable="d" 
      Foreground="{DynamicResource Theme_TextBrush}"
    d:DesignHeight="768" d:DesignWidth="1360"
    Title="StarterKitsPage">
    <Page.Resources>
        <local:MonsterIdToNameConverter x:Key="MonsterIdToNameConverter"/>
        
        
        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <DataTemplate x:Key="ComboItemTemplate">
            <TextBlock Text="{Binding}" FontSize="24" VerticalAlignment="Center"/>
        </DataTemplate>
    </Page.Resources>
    
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Background card -->
        <Rectangle Grid.RowSpan="3" RadiusX="3" RadiusY="3">
            <Rectangle.Stroke>
                <SolidColorBrush Color="{DynamicResource Theme_BorderColor}" />
            </Rectangle.Stroke>
            <Rectangle.Fill>
                <SolidColorBrush Color="{DynamicResource Theme_ControlBackgroundColor}" />
            </Rectangle.Fill>
        </Rectangle>
        <TextBlock Grid.Row="0" Text="Starter Kits" FontSize="24" FontWeight="Bold" Margin="8"/>
        <Button Grid.Row="0" Content="Patch All Kits" Margin="8" Padding="8,6" HorizontalAlignment="Right" Click="OnPatchAllKitsClick"/>


        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
 
            <ItemsControl Name="KitsItemsControl" Grid.Row="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="{Binding BaseName}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <Grid Margin="0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="AP:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="DF:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DF, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="PP:" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5,0"/>
                                </Grid>
                                <TextBlock Text="Cards" FontWeight="Bold" Margin="0,10,0,5"/>
                                <DataGrid ItemsSource="{Binding CardIDs}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="ID" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Value, Converter={StaticResource MonsterIdToNameConverter}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{x:Static vm:StarterKitsViewModel.MonsterList}"
                                                            DisplayMemberPath="Name"
                                                            SelectedValuePath="Id"
                                                              SelectedIndex="{Binding Value, Mode=OneWay}"
                                                              SelectionChanged="OnCardIdChanged">
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
