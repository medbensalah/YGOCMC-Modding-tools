<Page
    x:Class="YGO_CMC_Modding_tool.Pages.ShopsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:YGO_CMC_Modding_tool.Pages"
    xmlns:vm="clr-namespace:YGO_CMC_Modding_tool.ViewModels"
    mc:Ignorable="d" 
      Foreground="{DynamicResource Theme_TextBrush}"
    d:DesignHeight="768" d:DesignWidth="1360"
    Title="ShopsPage">
    <Page.Resources>
        <local:MonsterIdToNameConverter x:Key="MonsterIdToNameConverter"/>
    </Page.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Background card -->
        <Rectangle Grid.RowSpan="2" RadiusX="3" RadiusY="3">
            <Rectangle.Stroke>
                <SolidColorBrush Color="{DynamicResource Theme_BorderColor}" />
            </Rectangle.Stroke>
            <Rectangle.Fill>
                <SolidColorBrush Color="{DynamicResource Theme_ControlBackgroundColor}" />
            </Rectangle.Fill>
        </Rectangle>

        <TextBlock Grid.Row="0" Text="Shop Inventory" FontSize="24" FontWeight="Bold" Margin="8"/>
        <Button Grid.Row="0" Content="Patch Shop" Margin="8" Padding="8,6" HorizontalAlignment="Right" Click="OnPatchAllShopsClick"/>

        <TabControl Grid.Row="1" Margin="8 0 8 8">
            <TabItem Header="Attribute Shops">
                <ItemsControl x:Name="AttributeShopsItemsControl" ItemsSource="{x:Static vm:ShopsViewModel.AttributeShops}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <DataGrid ItemsSource="{Binding CardIDs}" AutoGenerateColumns="False" >
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Card ID" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Value, Converter={StaticResource MonsterIdToNameConverter}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{x:Static vm:ShopsViewModel.MonsterList}"
                                                                  DisplayMemberPath="Display"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Value, Mode=OneWay}"
                                                                  SelectionChanged="OnCardIdChanged"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                    </DataGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
            <TabItem Header="Area Shops">
                <ItemsControl x:Name="AreaShopsItemsControl" ItemsSource="{x:Static vm:ShopsViewModel.AreaShops}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <DataGrid ItemsSource="{Binding CardIDs}" AutoGenerateColumns="False" >
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Card ID" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Value, Converter={StaticResource MonsterIdToNameConverter}}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                    <DataGridTemplateColumn.CellEditingTemplate>
                                                        <DataTemplate>
                                                            <ComboBox ItemsSource="{x:Static vm:ShopsViewModel.MonsterList}"
                                                                  DisplayMemberPath="Display"
                                                                  SelectedValuePath="Id"
                                                                  SelectedValue="{Binding Value, Mode=OneWay}"
                                                                  SelectionChanged="OnCardIdChanged"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellEditingTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        </StackPanel>
                                    </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
